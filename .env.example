# .env.example — copy to .env and fill in real values (never commit .env)
#
# Supabase — check Dashboard > Project Settings > API for actual values
# New key format (sb_ prefix) for projects created after Supabase key migration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
SUPABASE_SECRET_KEY=sb_secret_XXXX
SUPABASE_JWT_SECRET=your-jwt-secret

# n8n
N8N_URL=https://joaomarcos1303.app.n8n.cloud/webhook/nfse-processing
N8N_TIMEOUT=90

# Frontend origins (comma-separated, no spaces)
ALLOWED_ORIGINS=https://yourapp.lovable.app,http://localhost:5173

# Temp storage for uploaded NFS-e XML files
UPLOAD_TEMP_DIR=/tmp/importarest

# Autmais API (NFS-e). Ask a admin for the real values.
AUTMAIS_TENANT=your-tenant-uuid-prefix
AUTMAIS_USERNAME=your_autmais_user
AUTMAIS_PASSWORD=your_autmais_password
AUTMAIS_AUTH_HOST=https://api2.autmais.com.br/v1
AUTMAIS_NFSE_HOST=https://apimongo.autmais.com.br/v1
